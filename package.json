{
  "name": "@halllky/editable-grid",
  "version": "0.10.0",
  "description": "React のデータグリッドコンポーネント",
  "keywords": [
    "react",
    "grid",
    "data-grid",
    "editable",
    "spreadsheet",
    "tanstack-table"
  ],
  "license": "MIT",
  "author": "halllky",
  "homepage": "https://halllky.github.io/editable-grid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halllky/editable-grid.git"
  },
  "bugs": {
    "url": "https://github.com/halllky/editable-grid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/stories"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run tsc && npm run build",
    "tsc": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.2",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "uuidjs": "^5.1.0",
    "vite": "^7.3.5",
    "vitest": "latest",
    "zod": "^4.6.5"
  }
}